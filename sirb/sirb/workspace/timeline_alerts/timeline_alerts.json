 "content": "[{\"id\":\"tla_title\",\"type\":\"header\",\"data\":{\"text\":\"<span class=\\\"h4\\\"><b>Timeline Alerts</b></span>\",\"col\":12}},{\"id\":\"tla_intro\",\"type\":\"paragraph\",\"data\":{\"col\":12,\"text\":\"E-mail students picked by programme, status or inactivity, now or on a schedule. Compose and schedule alerts in the <a href=\\\"/sirb/admin/alerts\\\">SIRB portal</a>; this page tracks what was sent.\"}},{\"id\":\"tla_card_0\",\"type\":\"number_card\",\"data\":{\"number_card_name\":\"Active Timeline Alerts\",\"col\":4}},{\"id\":\"tla_card_1\",\"type\":\"number_card\",\"data\":{\"number_card_name\":\"Alert Runs (Last 30 Days)\",\"col\":4}},{\"id\":\"tla_card_2\",\"type\":\"number_card\",\"data\":{\"number_card_name\":\"Alert E-mails Queued (Last 30 Days)\",\"col\":4}},{\"id\":\"tla_card_3\",\"type\":\"number_card\",\"data\":{\"number_card_name\":\"Alert Runs With Problems (Last 30 Days)\",\"col\":4}},{\"id\":\"tla_card_4\",\"type\":\"number_card\",\"data\":{\"number_card_name\":\"Alert E-mails Awaiting Delivery\",\"col\":4}},{\"id\":\"tla_card_5\",\"type\":\"number_card\",\"data\":{\"number_card_name\":\"Alert E-mail Delivery Errors (Last 30 Days)\",\"col\":4}},{\"id\":\"tla_sp1\",\"type\":\"spacer\",\"data\":{\"col\":12}},{\"id\":\"tla_sc_hdr\",\"type\":\"header\",\"data\":{\"text\":\"<span class=\\\"h4\\\"><b>Shortcuts</b></span>\",\"col\":12}},{\"id\":\"tla_sc_0\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Open Timeline Alerts\",\"col\":4}},{\"id\":\"tla_sc_1\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Scheduled Alerts\",\"col\":4}},{\"id\":\"tla_sc_2\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Alert Runs\",\"col\":4}},{\"id\":\"tla_sc_3\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Runs Needing Attention\",\"col\":4}},{\"id\":\"tla_sc_4\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Alert E-mail Queue\",\"col\":4}},{\"id\":\"tla_sc_5\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Email Templates